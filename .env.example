# MySQL / MariaDB
DATABASE_URL="mysql://root:password@127.0.0.1:3306/nexoraweb"

# Owner login (single user) and cookie signing secret (min 32 chars)
OWNER_PASSWORD="change-me"
SESSION_SECRET="change-me-to-a-random-string-of-32-chars-or-more"

# Bearer token (min 32 chars) for the owner JSON API at /api/owner/*, used by the MCP server. Empty keeps it off.
OWNER_API_TOKEN=""

# Ed25519 key pair, generate with `npm run keys:generate`.
# The private key stays here; the public key goes into each customer site (LICENSE_PUBLIC_KEY).
LICENSE_PRIVATE_KEY=""

# How many days a signed token stays valid after a check-in (grace period if this panel is down)
LICENSE_TOKEN_DAYS="7"

# Public address of this panel (the payment gateway sends buyers back here)
APP_URL="http://localhost:3001"

# Zarinpal merchant id for the "pay online" option; leave empty to turn it off.
# The gateway runs in sandbox mode everywhere except production (NODE_ENV=production uses the live one).
ZARINPAL_MERCHANT_ID=""
# "true" forces the sandbox even in a production build (use it with a test merchant id); leave empty to follow NODE_ENV.
ZARINPAL_SANDBOX=""
