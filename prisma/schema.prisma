generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum SiteStatus {
  ACTIVE
  SUSPENDED
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  AWAITING_PAYMENT
  FAILED
}

enum SubscriptionPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PurchaseMethod {
  CARD_TO_CARD
  ONLINE
}

enum LicenseEventType {
  SITE_CREATED
  FEATURES_CHANGED
  STATUS_CHANGED
  KEY_ROTATED
  CHECK_REJECTED
  PURCHASE_REQUESTED
  PURCHASE_RESOLVED
}

// Catalog of sellable capabilities. `key` matches LICENSE_FEATURES in the store project.
model Feature {
  key       String   @id @db.VarChar(64)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  group       String   @db.VarChar(80)
  price       Decimal  @default(0) @db.Decimal(14, 0)
  sortOrder Int      @default(0)
  // A disabled feature stays with the sites that already own it but cannot be bought for now.
  isActive    Boolean  @default(true)
  createdAt DateTime @default(now())

  siteFeatures     SiteFeature[]
  packageFeatures  PackageFeature[]
  purchaseRequests PurchaseRequest[]
  ratings          Rating[]
}

model Package {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  price     Decimal  @default(0) @db.Decimal(14, 0)
  // The package as a subscription plan: its price per month (the quarterly and yearly prices follow from the discounts in SubscriptionSettings). Empty = not offered as a plan.
  monthlyPrice Decimal? @db.Decimal(14, 0)
  createdAt DateTime @default(now())

  features         PackageFeature[]
  purchaseRequests PurchaseRequest[]
  ratings          Rating[]
  sites            Site[]           @relation("SitePlan")
}

model PackageFeature {
  packageId  String
  featureKey String @db.VarChar(64)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([packageId, featureKey])
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(120)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now())

  sites Site[]
}

model Site {
  id            String     @id @default(cuid())
  clientId      String
  domain        String     @unique @db.VarChar(191)
  licenseKeyHash String    @unique @db.VarChar(64)
  keyPrefix     String     @db.VarChar(16)
  status        SiteStatus @default(ACTIVE)
  contractPrice Decimal    @default(0) @db.Decimal(14, 0)
  expiresAt     DateTime?
  // The subscription plan (a package) and the period it was last paid for; expiresAt is where that subscription ends.
  planId        String?
  period        SubscriptionPeriod?
  notes         String?    @db.VarChar(1000)
  lastSeenAt    DateTime?
  // Where the site accepts "refresh now" messages; learned from its check-ins and limited to the registered domain.
  callbackUrl   String?    @db.VarChar(300)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client   Client         @relation(fields: [clientId], references: [id])
  plan     Package?       @relation("SitePlan", fields: [planId], references: [id], onDelete: SetNull)
  features         SiteFeature[]
  events           LicenseEvent[]
  purchaseRequests PurchaseRequest[]
  ratings          Rating[]

  @@index([clientId])
}

model SiteFeature {
  siteId     String
  featureKey String @db.VarChar(64)

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([siteId, featureKey])
}

model LicenseEvent {
  id        String           @id @default(cuid())
  siteId    String?
  type      LicenseEventType
  message   String           @db.VarChar(255)
  createdAt DateTime         @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

// Your fixed payment details, shown to a customer who wants to buy a locked feature.
model OwnerSettings {
  id           String  @id @default("main")
  holderName   String? @db.VarChar(120)
  cardNumber   String? @db.VarChar(16)
  sheba        String? @db.VarChar(26)
  bankName     String? @db.VarChar(60)
  contactPhone String? @db.VarChar(11)
  note         String? @db.VarChar(500)
}

// A customer site asked to unlock a feature after paying; approving it adds the feature to the site.
model PurchaseRequest {
  id           String         @id @default(cuid())
  siteId       String
  // Exactly one of featureKey / packageId is set.
  featureKey   String?        @db.VarChar(64)
  packageId    String?
  status       PurchaseStatus @default(PENDING)
  method       PurchaseMethod @default(CARD_TO_CARD)
  trackingCode String         @db.VarChar(60)
  note         String?        @db.VarChar(500)
  // Why a request was rejected; the site shows it to the buyer.
  rejectReason String?        @db.VarChar(500)
  // A package bought as a subscription for this period; empty for a one-off purchase.
  period       SubscriptionPeriod?
  // Online payments only: what was charged (toman), the gateway authority and reference, and where to send the buyer back.
  amount       Decimal?       @db.Decimal(14, 0)
  authority    String?        @unique @db.VarChar(64)
  refId        String?        @db.VarChar(64)
  returnUrl    String?        @db.VarChar(500)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([status, createdAt])
}

/// A site's star rating (1-5) of a feature or a ready package it bought; one per site and target, changeable.
model Rating {
  id         String   @id @default(cuid())
  siteId     String
  // Exactly one of featureKey / packageId is set.
  featureKey String?  @db.VarChar(64)
  packageId  String?
  stars      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([siteId, featureKey])
  @@unique([siteId, packageId])
  @@index([featureKey])
  @@index([packageId])
}

/// What the site is locked out of once the grace period after a subscription ends has passed.
enum SubscriptionLock {
  OPTIONAL_FEATURES
  ADMIN_PANEL
  FULL
}

/// Subscription rules, editable in the panel: how much longer periods are discounted, how long a site may keep working after its subscription ends, and what then happens.
model SubscriptionSettings {
  id                       String           @id @default("main")
  quarterlyDiscountPercent Int              @default(10)
  yearlyDiscountPercent    Int              @default(20)
  graceDays                Int              @default(7)
  retentionDays            Int              @default(90)
  lockAfterGrace           SubscriptionLock @default(ADMIN_PANEL)
  // Days before the end on which the site reminds its owner, comma separated (for example "7,3,1").
  reminderDays             String           @default("7,3,1") @db.VarChar(40)
}
