generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum SiteStatus {
  ACTIVE
  SUSPENDED
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  AWAITING_PAYMENT
  FAILED
}

enum PurchaseMethod {
  CARD_TO_CARD
  ONLINE
  WALLET
}

enum LicenseEventType {
  SITE_CREATED
  FEATURES_CHANGED
  STATUS_CHANGED
  KEY_ROTATED
  CHECK_REJECTED
  PURCHASE_REQUESTED
  PURCHASE_RESOLVED
}

enum TicketStatus {
  AWAITING_PAYMENT
  OPEN
  ANSWERED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  BILLING
  LICENSE
  FEATURE_REQUEST
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// How a support ticket was paid for.
enum TicketCharge {
  FREE
  WALLET
  ONLINE
}

enum WalletEntryType {
  TOPUP
  TICKET_FEE
  ADMIN_CREDIT
  ADMIN_DEBIT
  PURCHASE
}

enum TopupStatus {
  AWAITING_PAYMENT
  PENDING
  APPROVED
  REJECTED
  FAILED
}

// Catalog of sellable capabilities. `key` matches LICENSE_FEATURES in the store project.
model Feature {
  key       String   @id @db.VarChar(64)
  title       String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  group       String   @db.VarChar(80)
  price       Decimal  @default(0) @db.Decimal(14, 0)
  sortOrder Int      @default(0)
  // A disabled feature stays with the sites that already own it but cannot be bought for now.
  isActive    Boolean  @default(true)
  createdAt DateTime @default(now())

  siteFeatures     SiteFeature[]
  packageFeatures  PackageFeature[]
  purchaseRequests PurchaseRequest[]
  ratings          Rating[]
}

model Package {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  price     Decimal  @default(0) @db.Decimal(14, 0)
  createdAt DateTime @default(now())

  features         PackageFeature[]
  purchaseRequests PurchaseRequest[]
  ratings          Rating[]
}

model PackageFeature {
  packageId  String
  featureKey String @db.VarChar(64)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([packageId, featureKey])
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(120)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now())

  sites Site[]
}

model Site {
  id            String     @id @default(cuid())
  clientId      String
  domain        String     @unique @db.VarChar(191)
  licenseKeyHash String    @unique @db.VarChar(64)
  keyPrefix     String     @db.VarChar(16)
  status        SiteStatus @default(ACTIVE)
  contractPrice Decimal    @default(0) @db.Decimal(14, 0)
  notes         String?    @db.VarChar(1000)
  // Support is free until `supportFreeUntil` (set from `supportFreeMonths` when that is saved); after that every ticket costs the fee in OwnerSettings.
  supportFreeMonths Int       @default(0)
  supportFreeUntil  DateTime?
  walletBalance     Decimal   @default(0) @db.Decimal(14, 0)
  lastSeenAt    DateTime?
  // Where the site accepts "refresh now" messages; learned from its check-ins and limited to the registered domain.
  callbackUrl   String?    @db.VarChar(300)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client   Client         @relation(fields: [clientId], references: [id])
  features         SiteFeature[]
  events           LicenseEvent[]
  purchaseRequests PurchaseRequest[]
  ratings          Rating[]
  tickets          SupportTicket[]
  walletEntries    WalletEntry[]
  walletTopups     WalletTopup[]

  @@index([clientId])
}

model SiteFeature {
  siteId     String
  featureKey String @db.VarChar(64)

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([siteId, featureKey])
}

model LicenseEvent {
  id        String           @id @default(cuid())
  siteId    String?
  type      LicenseEventType
  message   String           @db.VarChar(255)
  createdAt DateTime         @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

// Your fixed payment details, shown to a customer who wants to buy a locked feature.
model OwnerSettings {
  id           String  @id @default("main")
  holderName   String? @db.VarChar(120)
  cardNumber   String? @db.VarChar(16)
  sheba        String? @db.VarChar(26)
  bankName     String? @db.VarChar(60)
  contactPhone String? @db.VarChar(11)
  note         String? @db.VarChar(500)
  // What one support ticket costs (toman) once a site's free support is over; 0 = tickets are free.
  ticketPrice  Decimal @default(0) @db.Decimal(14, 0)
}

// A customer site asked to unlock a feature after paying; approving it adds the feature to the site.
model PurchaseRequest {
  id           String         @id @default(cuid())
  siteId       String
  // Exactly one of featureKey / packageId is set.
  featureKey   String?        @db.VarChar(64)
  packageId    String?
  status       PurchaseStatus @default(PENDING)
  method       PurchaseMethod @default(CARD_TO_CARD)
  trackingCode String         @db.VarChar(60)
  note         String?        @db.VarChar(500)
  // Why a request was rejected; the site shows it to the buyer.
  rejectReason String?        @db.VarChar(500)
  // Online payments only: what was charged (toman), the gateway authority and reference, and where to send the buyer back.
  amount       Decimal?       @db.Decimal(14, 0)
  authority    String?        @unique @db.VarChar(64)
  refId        String?        @db.VarChar(64)
  returnUrl    String?        @db.VarChar(500)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([status, createdAt])
}

/// A site's star rating (1-5) of a feature or a ready package it bought; one per site and target, changeable.
model Rating {
  id         String   @id @default(cuid())
  siteId     String
  // Exactly one of featureKey / packageId is set.
  featureKey String?  @db.VarChar(64)
  packageId  String?
  stars      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([siteId, featureKey])
  @@unique([siteId, packageId])
  @@index([featureKey])
  @@index([packageId])
}

model SupportTicket {
  id        String       @id @default(cuid())
  // The number people quote ("ticket 1042"); the id stays the key.
  number    Int          @unique @default(autoincrement())
  category  TicketCategory @default(OTHER)
  priority  TicketPriority @default(NORMAL)
  siteId    String
  subject   String       @db.VarChar(191)
  status    TicketStatus @default(OPEN)
  charge    TicketCharge @default(FREE)
  // What this ticket cost (toman); 0 while support was free.
  fee       Decimal      @default(0) @db.Decimal(14, 0)
  // Direct (gateway) payment only.
  authority String?      @unique @db.VarChar(64)
  refId     String?      @db.VarChar(64)
  returnUrl String?      @db.VarChar(500)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?

  site     Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([siteId, createdAt])
  @@index([status, updatedAt])
  @@index([priority, status])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  // True when the owner wrote it, false for the site's admin.
  fromOwner Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Append-only history of a site's wallet; `amount` is signed and `balanceAfter` snapshots the balance.
model WalletEntry {
  id           String          @id @default(cuid())
  siteId       String
  amount       Decimal         @db.Decimal(14, 0)
  balanceAfter Decimal         @db.Decimal(14, 0)
  type         WalletEntryType
  description  String          @db.VarChar(191)
  ticketId     String?
  topupId      String?
  createdAt    DateTime        @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

/// A site's request to charge its wallet: online (verified with the gateway) or card-to-card (approved by the owner).
model WalletTopup {
  id           String         @id @default(cuid())
  siteId       String
  amount       Decimal        @db.Decimal(14, 0)
  method       PurchaseMethod
  status       TopupStatus
  trackingCode String?        @db.VarChar(60)
  rejectReason String?        @db.VarChar(500)
  authority    String?        @unique @db.VarChar(64)
  refId        String?        @db.VarChar(64)
  returnUrl    String?        @db.VarChar(500)
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([status, createdAt])
}

/// An online payment gateway the owner configured in the panel (credentials are stored encrypted).
model GatewaySetting {
  provider            String   @id @db.VarChar(40)
  credentialEncrypted String   @db.Text
  credentialMasked    String   @db.VarChar(80)
  isSandbox           Boolean  @default(false)
  isActive            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

/// The owner's Faraz SMS account: API key (encrypted) and the sender line.
model SmsSettings {
  id              String   @id @default("main")
  apiKeyEncrypted String?  @db.Text
  apiKeyMasked    String?  @db.VarChar(80)
  lineNumber      String?  @db.VarChar(40)
  isActive        Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// Every SMS the panel sent (or failed to send), newest first on the SMS page.
model SmsLog {
  id        String   @id @default(cuid())
  siteId    String?
  phone     String   @db.VarChar(11)
  text      String   @db.VarChar(1000)
  ok        Boolean
  error     String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// The owner's current AI assistant conversation (messages and approval cards waiting), so it survives reloads and devices.
model AiConversation {
  id        String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt
}
